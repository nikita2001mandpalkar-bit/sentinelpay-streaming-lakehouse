flowchart LR
    SRC[Source Systems<br/>PostgreSQL, JSON events,<br/>application logs, support tickets]
    KAFKA[Kafka Ingestion<br/>event.payment, event.refund,<br/>batch.settlement, support/log feeds]

    subgraph PLATFORM["SentinelPay Data Platform"]
        subgraph LAKE["Delta Lake on MinIO"]
            BRONZE[Bronze<br/>raw append-only ingestion]
            SILVER[Silver<br/>validated, deduplicated,<br/>watermarked datasets]
            GOLD[Gold<br/>payment summary,<br/>reconciliation, merchant SCD2]
        end

        PROC[Data Processing<br/>PySpark Structured Streaming<br/>Airflow orchestration]
        QUALITY[Quality and Recovery<br/>Great Expectations, quarantine,<br/>checkpoint recovery]
        ANALYTICS[Analytics Modelling<br/>dbt staging, marts, docs, lineage]
    end

    ACCESS[Access Layer<br/>SQL, docs, APIs, recruiter proof]
    PROOF[Monitoring and Proof<br/>Spark UI, Airflow UI,<br/>MinIO browser, GitHub]

    SRC --> KAFKA
    KAFKA --> BRONZE
    BRONZE --> SILVER
    SILVER --> GOLD
    BRONZE --> PROC
    SILVER --> QUALITY
    SILVER --> ANALYTICS
    GOLD --> ACCESS
    ANALYTICS --> ACCESS
    PROC --> PROOF
    QUALITY --> PROOF
    ACCESS --> PROOF

